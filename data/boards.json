{
 "updated": "2026-10-08",
 "about": "Public, no-login job boards. Each entry names the vendor ('type') and the account on that vendor ('board', or tenant/wd/site for Workday). Add your own in workspace/my_boards.json, same shape.",
 "templates": {
  "greenhouse": "GET https://boards-api.greenhouse.io/v1/boards/{board}/jobs?content=true",
  "lever": "GET https://api.lever.co/v0/postings/{board}?mode=json",
  "ashby": "GET https://api.ashbyhq.com/posting-api/job-board/{board}",
  "smartrecruiters": "GET https://api.smartrecruiters.com/v1/companies/{board}/postings?limit=100&offset=N (+ GET .../postings/{id} for body)",
  "rippling": "GET https://api.rippling.com/platform/api/ats/v1/board/{board}/jobs",
  "bamboohr": "GET https://{board}.bamboohr.com/careers/list (+ /careers/{id}/detail)",
  "workday": "POST https://{tenant}.{wd}.myworkdayjobs.com/wday/cxs/{tenant}/{site}/jobs body {\"appliedFacets\":{},\"limit\":20,\"offset\":0,\"searchText\":\"\"}",
  "amazon": "GET https://www.amazon.jobs/en/search.json?base_query=...&offset=0&result_limit=100",
  "intuit": "jobs.intuit.com/search-jobs/results (TalentBrew HTML) - see daily-job-brief scripts/fetch_a.py fetch_intuit",
  "microsoft": "apply.careers.microsoft.com/api/pcsx/search - see daily-job-brief scripts/fetch_a.py fetch_microsoft"
 },
